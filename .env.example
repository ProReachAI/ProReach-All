# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketing_agent

# Supabase Auth (Project Settings > API / Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Cloudflare Workers AI (keep the account on the free plan for a hard spend cap)
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_TEXT_FALLBACK_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
AI_DAILY_CAMPAIGN_LIMIT=5
AI_DAILY_IMAGE_LIMIT=30
AI_DAILY_PROFILE_LIMIT=10

# Cloudflare R2 media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=buildtoreach-media
R2_PUBLIC_BASE_URL=

# X (OAuth 2.0 + PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606

# Facebook Pages (Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# Instagram professional accounts (Business Login for Instagram)
# These may come from the same Meta developer app, but use the Instagram App ID
# and Instagram App Secret shown by the Instagram API product.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# Protect scheduler/webhook endpoints in production
CRON_SECRET=
